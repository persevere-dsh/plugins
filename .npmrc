# The DSH harness packages (@deepseek-ai/cordis, @deepseek-ai/dsh-typert-protocol)
# are RUNTIME PEERS supplied by the host that loads a plugin. npm >= 7 would
# otherwise auto-install a duplicate copy into ./node_modules, and a second copy
# of the protocol silently disables the Typert Remote layer. Peer auto-install is
# therefore disabled on purpose. See dsh-update-center/.npmrc for the same rule.
legacy-peer-deps=true
