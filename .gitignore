# This index repository holds no plugin sources: only READMEs, branding rules,
# and this ignore list. Plugins are separate repositories with their own
# .gitignore covering lib/ and dist/.

# Dependencies and local tool caches — never committed.
node_modules/
.npm/
*.tsbuildinfo

# Installable plugin tarballs — never committed.
*.tgz

# Editor / OS noise.
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
